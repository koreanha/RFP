# ── 이메일 발송 (필수) ────────────────────────────────────────────────────
# Gmail 앱 비밀번호 발급 방법:
#   1. Google 계정 → 보안 → 2단계 인증 활성화
#   2. https://myaccount.google.com/apppasswords 접속
#   3. 앱 이름 입력(예: RFP크롤러) → 16자리 비밀번호 발급
#   4. 공백 없이 그대로 붙여넣기
GMAIL_ADDRESS=koreanha@gmail.com
GMAIL_APP_PW=xxxx xxxx xxxx xxxx

# 수신자 (기본값이 koreanha@gmail.com 이므로 변경 시에만 설정)
# NOTIFY_TO=other@email.com

# ── RIPC 로그인 (선택) ────────────────────────────────────────────────────
RIPC_USERNAME=
RIPC_PASSWORD=
